MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/baddie-burger
PORT=5000
# Frontend origin allowed to call the API (deployed site URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Admin login (the only login on the site). Pick your own values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Any long random string, 16+ chars (signs login tokens)
JWT_SECRET=replace-with-a-long-random-string

# Optional kitchen-staff login (can view orders and update progress, cannot edit the menu)
STAFF_USERNAME=kitchen
STAFF_PASSWORD=change-me-too
